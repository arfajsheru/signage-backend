generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Vendor {
  id Int @id @default(autoincrement())

  name           String
  contact_person String?
  phone          String?
  email          String?
  address        String?

  gst_number String?
  pan_number String?

  opening_balance Float @default(0)

  is_active Boolean @default(true)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Relations
  users            User[]
  projects         Project[]
  channel_partners ChannelPartner[]
  dxf_extractions  DxfExtraction[]

  @@index([name])
}

model Role {
  id Int @id @default(autoincrement())

  name String @unique

  created_at DateTime @default(now())

  // Relations
  users User[]
}

model User {
  id Int @id @default(autoincrement())

  // Vendor relation
  vendor_id Int
  vendor    Vendor @relation(fields: [vendor_id], references: [id])

  // Role relation
  role_id Int
  role    Role @relation(fields: [role_id], references: [id])

  // Basic info
  name     String
  email    String
  password String

  phone String?

  is_active Boolean @default(true)

  last_login_at DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Relations
  created_projects Project[] @relation("ProjectCreatedBy")

  assignments ProjectAssignment[]

  uploaded_files StageFile[]

  approved_stages StageApproval[]

  created_stages ProjectStage[]

  @@unique([vendor_id, email])
  @@index([vendor_id])
  @@index([role_id])
}

model ChannelPartner {
  id Int @id @default(autoincrement())

  // Vendor relation
  vendor_id Int
  vendor    Vendor @relation(fields: [vendor_id], references: [id])

  // Basic info
  name           String
  contact_person String?
  phone          String?
  email          String?
  address        String?

  // Financial info
  gst_number      String?
  opening_balance Float   @default(0)
  credit_limit    Float   @default(0)

  // Payment terms
  payment_due_days Int?

  // Additional info
  notes String?

  is_active Boolean @default(true)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Relations
  projects Project[]

  @@index([vendor_id])
  @@index([name])
}

model BusinessType {
  id Int @id @default(autoincrement())

  // Example:
  // PRINT
  // SIGNAGE

  name String @unique

  created_at DateTime @default(now())

  // Relations
  workflows ProjectWorkflow[]

  projects Project[]

  categories ProjectCategory[]
}

model StageTypeMaster {
  id Int @id @default(autoincrement())

  stage_type Int    @unique
  code       String? @unique
  name       String @unique

  created_at DateTime @default(now())

  // Relations
  workflows ProjectWorkflow[]

  project_stages ProjectStage[]

  current_projects Project[] @relation("CurrentProjectStage")
}

model Project {
  id Int @id @default(autoincrement())

  vendor_id Int
  vendor    Vendor @relation(fields: [vendor_id], references: [id])

  business_type_id Int
  business_type    BusinessType @relation(fields: [business_type_id], references: [id])

  channel_partner_id Int?

  channel_partner ChannelPartner? @relation(fields: [channel_partner_id], references: [id])
  project_code    String
  name            String

  client_name  String?
  client_phone String?
  client_email String?

  project_source ProjectSource @default(DIRECT)

  site_address String?

  site_map_link String?

  project_category_id Int?
  project_category    ProjectCategory? @relation(fields: [project_category_id], references: [id])

  notes String?

  priority ProjectPriority @default(MEDIUM)

  status ProjectStatus @default(CREATED)

  current_stage_id Int?

  current_stage StageTypeMaster? @relation("CurrentProjectStage", fields: [current_stage_id], references: [id])

  current_stage_status StageStatus?

  progress_percentage Float @default(0)

  last_stage_updated_at DateTime?

  total_amount Float?

  advance_paid Float @default(0)

  deadline DateTime?

  created_by Int

  created_by_user User @relation("ProjectCreatedBy", fields: [created_by], references: [id])

  is_active Boolean @default(true)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  assignments ProjectAssignment[]

  stages ProjectStage[]

  dxf_extractions DxfExtraction[]

  @@index([vendor_id])
  @@index([business_type_id])
  @@index([channel_partner_id])
  @@index([created_by])
  @@index([current_stage_id])
  @@index([status])
  @@index([priority])
  @@index([project_code])
  @@index([client_name])
  @@index([project_category_id])
  @@index([deadline])
  @@index([project_source])

  @@unique([vendor_id, project_code])
}

model ProjectAssignment {
  id Int @id @default(autoincrement())

  // Project relation
  project_id Int
  project    Project @relation(fields: [project_id], references: [id])

  // User relation
  user_id Int
  user    User @relation(fields: [user_id], references: [id])

  assigned_at DateTime @default(now())

  @@unique([project_id, user_id])
  @@index([user_id])
}

model ProjectWorkflow {
  id Int @id @default(autoincrement())

  // Business type relation
  business_type_id Int
  business_type    BusinessType @relation(fields: [business_type_id], references: [id])

  // Stage relation
  stage_id Int
  stage    StageTypeMaster @relation(fields: [stage_id], references: [id])

  // Stage order
  sequence Int

  created_at DateTime @default(now())

  @@unique([business_type_id, sequence])
  @@unique([business_type_id, stage_id])
}

model ProjectStage {
  id Int @id @default(autoincrement())

  // Project relation
  project_id Int
  project    Project @relation(fields: [project_id], references: [id])

  // Stage relation
  stage_id Int
  stage    StageTypeMaster @relation(fields: [stage_id], references: [id])

  // Stage status
  status StageStatus

  started_at   DateTime?
  completed_at DateTime?

  remarks String?

  // Created by
  created_by   Int
  created_user User @relation(fields: [created_by], references: [id])

  created_at DateTime @default(now())

  // Relations
  files StageFile[]

  approvals StageApproval[]

  @@index([project_id])
  @@index([stage_id])
  @@index([status])
}

model DocumentType {
  id Int @id @default(autoincrement())

  // Example:
  // 1 = DESIGN
  // 2 = CUTTING

  document_type Int    @unique
  name          String @unique

  created_at DateTime @default(now())

  // Relations
  files StageFile[]
}

model StageFile {
  id Int @id @default(autoincrement())

  // Project stage relation
  project_stage_id Int
  project_stage    ProjectStage @relation(fields: [project_stage_id], references: [id])

  // File URL and Storage Info
  file_url  String
  public_id String?

  // Document type relation
  document_type_id Int
  document_type    DocumentType @relation(fields: [document_type_id], references: [id])

  // Uploaded by
  uploaded_by   Int
  uploaded_user User @relation(fields: [uploaded_by], references: [id])

  created_at DateTime @default(now())

  @@index([project_stage_id])
  @@index([document_type_id])
}

model StageApproval {
  id Int @id @default(autoincrement())

  // Project stage relation
  project_stage_id Int
  project_stage    ProjectStage @relation(fields: [project_stage_id], references: [id])

  // Approval status
  approval_status ApprovalStatus

  remarks String?

  // Approved by
  approved_by   Int?
  approved_user User? @relation(fields: [approved_by], references: [id])

  approved_at DateTime?

  created_at DateTime @default(now())

  @@index([project_stage_id])
  @@index([approval_status])
}

enum ProjectStatus {
  CREATED
  ACTIVE
  IN_PROGRESS
  COMPLETED
  CANCELLED
  ON_HOLD
}

enum StageStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  REJECTED
}


model ProjectCategory {
  id Int @id @default(autoincrement())

  business_type_id Int

  business_type BusinessType @relation(fields: [business_type_id], references: [id])

  category_name String

  is_active Boolean @default(true)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  projects Project[]

  @@index([business_type_id])

  @@index([category_name])

  @@unique([business_type_id, category_name])
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ProjectPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ProjectSource {
  DIRECT
  CHANNEL_PARTNER
}

// ─── DXF Extraction Models ────────────────────────────────────────────────────

model DxfExtraction {
  id Int @id @default(autoincrement())

  vendor_id Int
  vendor    Vendor @relation(fields: [vendor_id], references: [id])

  project_id Int?
  project    Project? @relation(fields: [project_id], references: [id])

  session_id     String  @unique
  file_name      String
  unit           String  @default("mm")

  total_design_width  Float @default(0)
  total_design_height Float @default(0)
  total_area          Float @default(0)
  total_cutting_length Float @default(0)
  total_objects       Int   @default(0)
  total_letters       Int   @default(0)
  detected_layers     String[] // JSON array stored as text[]

  raw_text  String[]
  warnings  String[]

  parsed_at  DateTime
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  objects DxfObject[]

  @@index([vendor_id])
  @@index([project_id])
  @@index([session_id])
}

model DxfObject {
  id Int @id @default(autoincrement())

  extraction_id Int
  extraction    DxfExtraction @relation(fields: [extraction_id], references: [id], onDelete: Cascade)

  object          String
  entity_type     String
  layer           String @default("DEFAULT")

  width            Float
  height           Float
  calculated_size  Float
  quantity         Int   @default(1)

  bbox_min_x Float @default(0)
  bbox_min_y Float @default(0)
  bbox_max_x Float @default(0)
  bbox_max_y Float @default(0)

  cutting_length Float?

  is_text  Boolean @default(false)
  is_group Boolean @default(false)

  created_at DateTime @default(now())

  @@index([extraction_id])
  @@index([layer])
}

